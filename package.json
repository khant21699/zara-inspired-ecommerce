{
  "name": "zara-inspired-ecommerce",
  "private": true,
  "description": "Zara-inspired storefront: Next.js web app and Express API in one repo, deployed separately.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
