PORT=4000
DATABASE_URL=postgres://user:password@host:5432/dbname
# Browser origins allowed by CORS and trusted by Better Auth, comma-separated;
# `*` matches anything (e.g. https://zara-inspired-ecommerce.vercel.app,https://*.vercel.app,http://localhost:3000).
FRONTEND_ORIGIN=http://localhost:3000
# Better Auth. Generate the secret with `npm run auth:secret -w apps/api`;
# the URL is this API's own public address (auth routes hang off it).
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:4000
